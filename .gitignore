# ── 构建产物 ─────────────────────────────────────────────
# 编译输出（每个工程都有 bin/obj）
[Bb]in/
[Oo]bj/
dist/
dist-framework-dependent/

# Logo 生成器的输出目录（src\R2Manager\app.ico 是源文件，要提交；
# tools\logo\out 里的是生成物，不提交）
tools/logo/out/

# ── 本地工具环境 ─────────────────────────────────────────
# 打包脚本用的隔离 Python 环境（22 MB，含原生依赖）
tools/.venv7z/

# ── 运行时生成 / 用户数据 ────────────────────────────────
# 配置文件：里面存着加密后的密钥，绝不能进仓库
settings.json
logs/
*.log

# 截图用的临时工作目录（里面会拷一份 exe）
/.shot-tmp/

# ── IDE 与系统 ──────────────────────────────────────────
.vs/
.vscode/
.idea/
*.user
*.suo
*.userprefs
Thumbs.db
desktop.ini

# ── 本地遗留 ────────────────────────────────────────────
# 根目录这份是 app.ico 的重复副本（当初手工上传时留下的），
# 真正的图标源文件在 src\R2Manager\app.ico
/上传logo.ico
